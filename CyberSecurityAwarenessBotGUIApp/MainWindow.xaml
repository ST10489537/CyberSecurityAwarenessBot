<Window x:Class="CyberSecurityAwarenessBotGUIApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#EAF2FB">

    <Grid Margin="20">

        <!-- Row Structure -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#003366"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="CYBERSECURITY AWARENESS BOT"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Helping South African citizens stay safe online"
                           Foreground="#DDEEFF"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

                <TextBlock Text="╔════════════════════════════════╗&#10;║ 🔐 SECURITY • PRIVACY • SAFETY ║&#10;╚════════════════════════════════╝"
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

            </StackPanel>

        </Border>

        <!-- PART 3 TAB CONTROL -->
        <TabControl Grid.Row="1"
                    Grid.RowSpan="2">

            <!-- CHAT TAB -->
            <TabItem Header="Chat">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="15"
                            BorderBrush="#B0C4DE"
                            BorderThickness="1">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <TextBlock x:Name="ChatDisplay"
                                       TextWrapping="Wrap"
                                       FontSize="15"
                                       FontFamily="Segoe UI"/>

                        </ScrollViewer>

                    </Border>

                    <Grid Grid.Row="1"
                          Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="UserInputTextBox"
                                 Grid.Column="0"
                                 Height="40"
                                 FontSize="15"
                                 Padding="10"
                                 VerticalContentAlignment="Center"
                                 KeyDown="UserInputTextBox_KeyDown"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Content="Send"
                                Margin="10,0,0,0"
                                Background="#003366"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="SendButton_Click"/>

                        <Button x:Name="ClearButton"
                                Grid.Column="2"
                                Content="Clear"
                                Margin="10,0,0,0"
                                Background="#607D8B"
                                Foreground="White"
                                FontWeight="Bold"
                                Click="ClearButton_Click"/>

                    </Grid>

                </Grid>

            </TabItem>

            <!-- TASK ASSISTANT TAB -->
            <TabItem Header="Task Assistant">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Task Title"
                               FontWeight="Bold"/>

                    <TextBox x:Name="TaskTitleBox"
                             Grid.Row="1"
                             Height="35"
                             Margin="0,5,0,10"/>

                    <TextBox x:Name="TaskDescriptionBox"
                             Grid.Row="2"
                             Height="70"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,5,0,10"/>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal">

                        <DatePicker x:Name="ReminderDatePicker"
                                    Width="180"/>

                        <Button Content="Add Task"
                                Width="120"
                                Margin="15,0,0,0"
                                Click="AddTaskButton_Click"/>

                    </StackPanel>

                    <DataGrid x:Name="TaskGrid"
                              Grid.Row="4"
                              Margin="0,15,0,0"
                              AutoGenerateColumns="True"/>

                </Grid>

            </TabItem>

            <!-- QUIZ TAB -->
            <TabItem Header="Cyber Quiz">

                <StackPanel Margin="20">

                    <TextBlock Text="Cybersecurity Knowledge Quiz"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock x:Name="QuizQuestionText"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>

                    <ListBox x:Name="QuizAnswers"
                             Height="180"
                             Margin="0,0,0,15"/>

                    <Button Content="Submit Answer"
                            Width="150"
                            Height="40"
                            Click="SubmitAnswer_Click"/>

                    <TextBlock x:Name="QuizFeedback"
                               Margin="0,20,0,0"
                               FontWeight="Bold"/>

                </StackPanel>

            </TabItem>

            <!-- ACTIVITY LOG TAB -->
            <TabItem Header="Activity Log">

                <StackPanel Margin="20">

                    <Button Content="Refresh Activity Log"
                            Width="180"
                            Height="40"
                            Click="RefreshLog_Click"/>

                    <ListBox x:Name="ActivityLogList"
                             Margin="0,15,0,0"
                             Height="400"/>

                </StackPanel>

            </TabItem>

        </TabControl>

    </Grid>

</Window>